+            DynamicsStateBatch batch;
+            if (dynamics_states_.empty())
+                return batch;
+
+            batch.buffer_first_sequence = dynamics_states_.front().sequence;
+            batch.buffer_last_sequence = dynamics_states_.back().sequence;
+            batch.samples_dropped = after_sequence != 0 &&
+                                    batch.buffer_first_sequence > after_sequence + 1;
+
+            const uint sample_limit = std::min<uint>(max_samples == 0 ? 4096 : max_samples, 4096);
+            batch.samples.reserve(sample_limit);
+            for (const auto& sample : dynamics_states_) {
+                if (sample.sequence > after_sequence) {
+                    batch.samples.push_back(sample);
+                    if (batch.samples.size() >= sample_limit)
+                        break;
+                }
+            }
+            return batch;
+        }
